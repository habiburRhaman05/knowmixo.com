# Copy this file to backend/.env and fill the real values. The backend
# fails loudly on boot if a required one is missing (see app/config.py).
# Never commit the real .env; see .gitignore.

# === Environment ===
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000      # Next.js app URL (used in emails)
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# === Database (Neon or local Postgres) ===
# postgresql://user:pass@host:port/db?sslmode=require
DATABASE_URL=

# === Redis (Upstash or local) ===
REDIS_URL=redis://localhost:6379

# === Pinecone ===
PINECONE_API_KEY=
PINECONE_INDEX_NAME=knowmivo-rag-sa
PINECONE_HOST=                            # https://<index>-<id>.svc.<region>.pinecone.io

# === Cloudflare Workers AI (embeddings) ===
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIM=1024

# === Groq (chat LLM) ===
GROQ_API_KEY=
CHAT_MODEL=openai/gpt-oss-120b
FREE_ONLY=true

# === RAG engine (v1 = proven single-shot, v2 = multi-stage state machine) ===
RAG_ENGINE=v1

# === Channels: WhatsApp Cloud API + Meta (Messenger/Instagram) ===
# Live delivery PENDING_EXTERNAL on Meta business verification + template
# approval -- leave blank in dev, the adapters no-op/log instead of failing.
CHANNELS_API_VERSION=v19.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
MESSENGER_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=

# === Slack app (D9.5): OAuth install + alerts channel delivery ===
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# === Budget enforcement (docs/04 "Budget enforcement") ===
GLOBAL_CHAT_DAILY_LIMIT=1000
COMPANY_CHAT_DAILY_LIMIT=100

# === Google OAuth (same id as NEXT_PUBLIC_GOOGLE_CLIENT_ID) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Email (Gmail app password or any SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM="Knowmivo <no-reply@example.com>"

# === Secrets ===
AUTH_SECRET=                              # 32+ random bytes, base64
ENCRYPTION_KEY=                           # 32 bytes hex (AES-256)

# === Storage ===
STORAGE_BACKEND=local
PRIVATE_STORAGE_DIR=/tmp/knowmivo-storage
MAX_FILE_BYTES=10485760
MAX_CRAWL_PAGES=20
MAX_COMPANY_STORAGE_BYTES=104857600

# === Testing ===
# Set this to a DISPOSABLE Postgres before running the DB-backed suites.
TEST_DATABASE_URL=

# === RAG v2 (added by launch/13 Day 1) ===
RERANKER_PROVIDER=cloudflare
RERANKER_MODEL=@cf/baai/bge-reranker-base
JINA_API_KEY=

# === Provider router fallback ===
OPENROUTER_API_KEY=

# === Storage (Cloudflare R2) ===
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=knowmivo-prod-sources
R2_ACCOUNT_ID=

# === Billing (Stripe) ===
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=true
STRIPE_PRICE_FREE=free
STRIPE_PRICE_STARTER_MONTHLY=starter_monthly
STRIPE_PRICE_STARTER_YEARLY=starter_yearly
STRIPE_PRICE_GROWTH_MONTHLY=growth_monthly
STRIPE_PRICE_GROWTH_YEARLY=growth_yearly
STRIPE_PRICE_SCALE_MONTHLY=scale_monthly
STRIPE_PRICE_SCALE_YEARLY=scale_yearly
STRIPE_PRICE_AGENCY_MONTHLY=agency_monthly
STRIPE_PRICE_AGENCY_YEARLY=agency_yearly
STRIPE_PRICE_OVERAGE_REPLY=overage_reply

# === WhatsApp Cloud API (PENDING_EXTERNAL approvals) ===
WA_BUSINESS_ACCOUNT_ID=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_WEBHOOK_VERIFY_TOKEN=

# === Twilio (SMS) ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# === Slack app ===
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# === Telegram ===
TG_BOT_TOKEN=

# === Email (Postmark — replaces Gmail SMTP for production) ===
POSTMARK_SERVER_TOKEN=
TRANSACTIONAL_FROM="Knowmivo <no-reply@knowmivo.com>"
LEGAL_COMPANY_ADDRESS="Knowmivo, 123 Example St, Wilmington DE 19801, USA"

# === Observability ===
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
