# Database
DATABASE_URL="postgresql://user:password@host:5432/knowmivo?sslmode=require"

# Redis (native, not Upstash REST)
REDIS_URL="redis://user:password@localhost:6379"

# Pinecone
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_NAME="knowmixo-rag-sa"
PINECONE_HOST="https://your-index.svc.pinecone.io"

# Cloudflare Embeddings
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_API_TOKEN="your-scoped-api-token"
EMBEDDING_MODEL="@cf/baai/bge-m3"
EMBEDDING_DIM="1024"

# Groq LLM (Phase 1–6, before OpenRouter pivot)
GROQ_API_KEY="your-groq-api-key"
CHAT_MODEL="openai/gpt-oss-120b"
FREE_ONLY="true"

# LLM budgets
GLOBAL_CHAT_DAILY_LIMIT="1000"
COMPANY_CHAT_DAILY_LIMIT="100"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email (Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_USER="your-gmail@gmail.com"
SMTP_APP_PASSWORD="your-app-password"
EMAIL_FROM="your-email@gmail.com"

# Auth.js / session
AUTH_SECRET="generate-a-strong-random-secret"
SESSION_MAX_AGE_SECONDS="604800"

# Encryption (for sensitive fields at rest)
ENCRYPTION_KEY="your-32-byte-hex-key-for-aes256"

# Storage
STORAGE_BACKEND="local"
PRIVATE_STORAGE_DIR="/tmp/knowmivo-storage"
MAX_FILE_BYTES="10485760"

# Job runner tuning
JOB_MAX_ATTEMPTS="4"
JOB_LEASE_SECONDS="300"

# Retention
RETENTION_DAYS="30"

# App environment
APP_ENV="development"
PUBLIC_APP_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:8000"
