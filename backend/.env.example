# Copy this file to backend/.env and fill the real values. The backend
# fails loudly on boot if a required one is missing (see app/config.py).
# Never commit the real .env; see .gitignore.

# === Environment ===
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000      # Next.js app URL (used in emails)
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# === Database (Neon or local Postgres) ===
# postgresql://user:pass@host:port/db?sslmode=require
DATABASE_URL=

# === Redis (Upstash or local) ===
REDIS_URL=redis://localhost:6379

# === Pinecone ===
PINECONE_API_KEY=
PINECONE_INDEX_NAME=knowmivo-rag-sa
PINECONE_HOST=                            # https://<index>-<id>.svc.<region>.pinecone.io

# === Cloudflare Workers AI (embeddings) ===
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIM=1024

# === Groq (chat LLM) ===
GROQ_API_KEY=
CHAT_MODEL=openai/gpt-oss-120b
FREE_ONLY=true

# === Budget enforcement (docs/04 "Budget enforcement") ===
GLOBAL_CHAT_DAILY_LIMIT=1000
COMPANY_CHAT_DAILY_LIMIT=100

# === Google OAuth (same id as NEXT_PUBLIC_GOOGLE_CLIENT_ID) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Email (Gmail app password or any SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM="Knowmivo <no-reply@example.com>"

# === Secrets ===
AUTH_SECRET=                              # 32+ random bytes, base64
ENCRYPTION_KEY=                           # 32 bytes hex (AES-256)

# === Storage ===
STORAGE_BACKEND=local
PRIVATE_STORAGE_DIR=/tmp/knowmivo-storage
MAX_FILE_BYTES=10485760
MAX_CRAWL_PAGES=20
MAX_COMPANY_STORAGE_BYTES=104857600

# === Testing ===
# Set this to a DISPOSABLE Postgres before running the DB-backed suites.
TEST_DATABASE_URL=
