# Where this Next.js app sends BFF calls. Server-side only.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Public origin of this app (used in error pages, embed snippets, meta tags).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Identity Services client ID. Public by design (it's rendered into the
# login page). The backend verifies the id_token independently.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# === Google OAuth (same id as NEXT_PUBLIC_GOOGLE_CLIENT_ID) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only shared secret used by the BFF when forwarding the parent-page
# origin to the backend for widget calls (docs/22 B-F1). Not needed for Phase 1.
BFF_TRUSTED_ORIGIN_SECRET=

# When set to "true" the BFF skips upstream calls that would otherwise fail
# without a running backend; used in F0 before the backend is reachable.
MOCK_BACKEND=false
